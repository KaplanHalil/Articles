\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces The architecture of XMSS. A WOTS+ secret key $\mathit  {sk}_i$ (consisting of $\ell $ random $n$-byte strings) is used to sign a message digest. The corresponding WOTS+ public key $\mathit  {pk}_i$ (obtained by hashing each chain $w{-}1$ times) is compressed via an L-Tree into a single leaf $L_i$. This leaf is placed in a Merkle tree of height $h$, whose root serves as the overall XMSS public key.}}{12}{figure.5}\protected@file@percent }
\newlabel{fig:xmss}{{5}{12}{The architecture of XMSS. A WOTS+ secret key $\mathit {sk}_i$ (consisting of $\ell $ random $n$-byte strings) is used to sign a message digest. The corresponding WOTS+ public key $\mathit {pk}_i$ (obtained by hashing each chain $w{-}1$ times) is compressed via an L-Tree into a single leaf $L_i$. This leaf is placed in a Merkle tree of height $h$, whose root serves as the overall XMSS public key}{figure.5}{}}
