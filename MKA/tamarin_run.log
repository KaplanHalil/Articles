lemma rekey_cannot_start_before_initial_completion:
  all-traces
  "∀ mn_ks2 kn1 sak2 #i.
    (RekeyStarted( mn_ks2, kn1, sak2 ) @ #i) ⇒
    (∃ mn_ks1 mn_s1 kn sak1 #j.
      (InitialSessionCompleted( mn_ks1, mn_s1, kn, sak1 ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ mn_ks2 kn1 sak2 #i.
  (RekeyStarted( mn_ks2, kn1, sak2 ) @ #i)
 ∧
  ∀ mn_ks1 mn_s1 kn sak1 #j.
   (InitialSessionCompleted( mn_ks1, mn_s1, kn, sak1 ) @ #j) ⇒ ¬(#j < #i)"
*/
simplify
solve( !SharedCAK( ~cak ) ▶₀ #i )
  case Setup_CAK
  solve( KSSTATE1( mn_ks1, mn_s1, ~kn, sak1 ) ▶₁ #i )
    case Initial_KeyServer_Confirm
    by contradiction /* from formulas */
  qed
qed

lemma rekey_after_initial_completion:
  all-traces
  "∀ mn_ks2 mn_s2 kn1 sak2 #i.
    (RekeySessionCompleted( mn_ks2, mn_s2, kn1, sak2 ) @ #i) ⇒
    (∃ mn_ks1 mn_s1 kn sak1 #j.
      (InitialSessionCompleted( mn_ks1, mn_s1, kn, sak1 ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ mn_ks2 mn_s2 kn1 sak2 #i.
  (RekeySessionCompleted( mn_ks2, mn_s2, kn1, sak2 ) @ #i)
 ∧
  ∀ mn_ks1 mn_s1 kn sak1 #j.
   (InitialSessionCompleted( mn_ks1, mn_s1, kn, sak1 ) @ #j) ⇒ ¬(#j < #i)"
*/
simplify
solve( !SharedCAK( ~cak ) ▶₁ #i )
  case Setup_CAK
  solve( KSSTATE2( mn_ks2, mn_s1, kn1, sak2 ) ▶₂ #i )
    case Rekey_KeyServer_Send
    by contradiction /* from formulas */
  qed
qed

lemma key_update:
  all-traces
  "∀ mn_ks1 mn_s1 kn sak1 mn_ks2 mn_s2 kn1 sak2 #i #j.
    ((InitialSessionCompleted( mn_ks1, mn_s1, kn, sak1 ) @ #i) ∧
     (RekeySessionCompleted( mn_ks2, mn_s2, kn1, sak2 ) @ #j)) ⇒
    (¬(sak1 = sak2))"
/*
guarded formula characterizing all counter-examples:
"∃ mn_ks1 mn_s1 kn sak1 mn_ks2 mn_s2 kn1 sak2 #i #j.
  (InitialSessionCompleted( mn_ks1, mn_s1, kn, sak1 ) @ #i) ∧
  (RekeySessionCompleted( mn_ks2, mn_s2, kn1, sak2 ) @ #j)
 ∧
  sak1 = sak2"
*/
simplify
solve( !SharedCAK( ~cak ) ▶₁ #i )
  case Setup_CAK
  solve( KSSTATE0( mn_ks1, mn_s, ~kn, sak1 ) ▶₂ #i )
    case Initial_KeyServer_Send
    solve( !SharedCAK( ~cak.2 ) ▶₁ #j )
      case Setup_CAK
      by solve( KSSTATE2( mn_ks2, mn_s1, kn1,
                          kdf(~cak.1, <$Keyserver, ~kn, ~KS_nonce0>)
                ) ▶₂ #j )
    qed
  qed
qed

lemma key_number_progress:
  all-traces
  "∀ mn_ks2 mn_s2 kn1 sak2 #i.
    (RekeySessionCompleted( mn_ks2, mn_s2, kn1, sak2 ) @ #i) ⇒
    (∃ kn mn_ks1 mn_s1 sak1 #j.
      (InitialSessionCompleted( mn_ks1, mn_s1, kn, sak1 ) @ #j) ∧
      (kn1 = count(kn)))"
/*
guarded formula characterizing all counter-examples:
"∃ mn_ks2 mn_s2 kn1 sak2 #i.
  (RekeySessionCompleted( mn_ks2, mn_s2, kn1, sak2 ) @ #i)
 ∧
  ∀ kn mn_ks1 mn_s1 sak1 #j.
   (InitialSessionCompleted( mn_ks1, mn_s1, kn, sak1 ) @ #j) ∧
   (kn1 = count(kn))
  ⇒
   ⊥"
*/
simplify
solve( !SharedCAK( ~cak ) ▶₁ #i )
