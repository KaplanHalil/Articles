lemma initial_sak_secrecy_no_reveal:
  all-traces
  "∀ mn_ks1 mn_s1 kn sak1 #i.
    (((InitialSessionCompleted( mn_ks1, mn_s1, kn, sak1 ) @ #i) ∧
      (¬(∃ #k. RevealSAK( mn_ks1, mn_s1, kn, sak1 ) @ #k))) ∧
     (¬(∃ cak #l. RevealCAK( cak ) @ #l))) ⇒
    (¬(∃ #m. K( sak1 ) @ #m))"
/*
guarded formula characterizing all counter-examples:
"∃ mn_ks1 mn_s1 kn sak1 #i.
  (InitialSessionCompleted( mn_ks1, mn_s1, kn, sak1 ) @ #i)
 ∧
  (∀ #k. (RevealSAK( mn_ks1, mn_s1, kn, sak1 ) @ #k) ⇒ ⊥) ∧
  (∀ cak #l. (RevealCAK( cak ) @ #l) ⇒ ⊥) ∧
  (∃ #m. (K( sak1 ) @ #m))"
*/
simplify
solve( !SharedCAK( ~cak ) ▶₁ #i )
  case Setup_CAK
  solve( KSSTATE0( mn_ks1, mn_s, ~kn, sak1 ) ▶₂ #i )
    case Initial_KeyServer_Send
    solve( !KU( mac(<$Server, count(genMN($Server.1)), ~kn>,
                    kdf(~cak, 'ICK'))
           ) @ #vk.6 )
      case Initial_Server_Receive
      solve( splitEqs(1) )
        case split_case_1
        solve( !KU( kdf(~cak.1, <$Keyserver, ~kn, ~KS_nonce0>) ) @ #vk.9 )
          case Initial_KeyServer_Send
          solve( !KU( mac(<$Keyserver.1, count(genMN($Keyserver.1)), ~kn, c1>,
                          kdf(~cak, 'ICK'))
                 ) @ #vk.15 )
            case Initial_KeyServer_Send
