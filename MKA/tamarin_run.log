rule (modulo E) Reveal_SAK:
   [ KSSTATE0( mn_ks, mn_s, kn, sak ) ]
  --[ RevealSAK( mn_ks, mn_s, kn, sak ) ]->
   [ Out( sak ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal_CAK:
   [ !SharedCAK( ~cak ) ] --[ RevealCAK( ~cak ) ]-> [ Out( ~cak ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Malicious_KeyServer_Send:
   [ !SharedCAK( ~cak ), Fr( ~fakeSAK ), Fr( ~kn ) ]
  --[ MaliciousSAKSent( ~fakeSAK ) ]->
   [
   Out( <$Keyserver, count(genMN($Keyserver)), ~kn, 
         senc(~fakeSAK, kdf(~cak, 'KEK')), 
         mac(<$Keyserver, count(genMN($Keyserver)), ~kn, 
              senc(~fakeSAK, kdf(~cak, 'KEK'))>,
             kdf(~cak, 'ICK'))
        >
   )
   ]

  /* has exactly the trivial AC variant */

lemma executable:
  exists-trace
  "∃ mn_ks1 mn_s1 kn sak1 mn_ks2 mn_s2 kn1 sak2 #i #j.
    (InitialSessionCompleted( mn_ks1, mn_s1, kn, sak1 ) @ #i) ∧
    (RekeySessionCompleted( mn_ks2, mn_s2, kn1, sak2 ) @ #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ mn_ks1 mn_s1 kn sak1 mn_ks2 mn_s2 kn1 sak2 #i #j.
  (InitialSessionCompleted( mn_ks1, mn_s1, kn, sak1 ) @ #i) ∧
  (RekeySessionCompleted( mn_ks2, mn_s2, kn1, sak2 ) @ #j)"
*/
simplify
solve( !SharedCAK( ~cak ) ▶₁ #i )
  case Setup_CAK
  solve( KSSTATE0( mn_ks1, mn_s, ~kn, sak1 ) ▶₂ #i )
    case Initial_KeyServer_Send
    solve( !SharedCAK( ~cak.2 ) ▶₁ #j )
      case Setup_CAK
      solve( KSSTATE2( mn_ks2, mn_s1, kn1, sak2 ) ▶₂ #j )
        case Rekey_KeyServer_Send
        solve( !KU( mac(<$Server, count(genMN($Server.1)), ~kn>,
                        kdf(~cak, 'ICK'))
               ) @ #vk.6 )
          case Initial_Server_Receive
          solve( splitEqs(2) )
            case split_case_1
            solve( !KU( mac(<$Server.1, count(count(genMN($Server.2))), count(~kn.1)
                            >,
                            kdf(~cak.2, 'ICK'))
                   ) @ #vk.15 )
              case c_mac
              solve( !KU( mac(<$Server.3, count(genMN($Server.2)), ~kn.1>,
                              kdf(~cak.5, 'ICK'))
                     ) @ #vk.25 )
                case Initial_Server_Receive
                solve( splitEqs(4) )
                  case split_case_1
                  solve( !KU( mac(<$Keyserver.3, count(genMN($Keyserver.3)), ~kn, c1>,
                                  kdf(~cak, 'ICK'))
                         ) @ #vk.32 )
                    case c_mac
                    solve( !KU( kdf(~cak.2, 'ICK') ) @ #vk.37 )
                      case c_kdf
                      solve( !KU( ~cak.2 ) @ #vk.44 )
                        case Reveal_CAK
                        solve( !KU( mac(<$Keyserver.4, count(genMN($Keyserver.4)), ~kn.1, 
                                         senc(z, kdf(~cak.4, 'KEK'))>,
                                        kdf(~cak.4, 'ICK'))
                               ) @ #vk.43 )
                          case Initial_KeyServer_Send
                          solve( !KU( kdf(~cak, 'ICK') ) @ #vk.44 )
                            case c_kdf
                            solve( !KU( ~cak ) @ #vk.46 )
                              case Reveal_CAK
                              solve( !KU( ~kn ) @ #vk.28 )
                                case Initial_KeyServer_Send
                                solve( !KU( ~kn.1 ) @ #vk.39 )
                                  case Initial_KeyServer_Send
                                  solve( !KU( count(genMN($Server)) ) @ #vk.30 )
                                    case c_count
                                    solve( !KU( genMN($Server) ) @ #vk.47 )
                                      case c_genMN
                                      solve( !KU( count(count(genMN($Server.2))) ) @ #vk.36 )
                                        case c_count
                                        solve( !KU( count(genMN($Server.2)) ) @ #vk.40 )
                                          case c_count
                                          solve( !KU( genMN($Server.2) ) @ #vk.48 )
                                            case c_genMN
                                            solve( !KU( count(~kn.1) ) @ #vk.40 )
                                              case Rekey_KeyServer_Send
                                              solve( !KU( count(genMN($Keyserver.3)) ) @ #vk.43 )
                                                case c_count
                                                solve( !KU( genMN($Keyserver.3) ) @ #vk.49 )
                                                  case c_genMN
                                                  solve( !KU( count(genMN($Keyserver.1)) ) @ #vk.47 )
                                                    case c_count
                                                    solve( !KU( genMN($Keyserver.1) ) @ #vk.50 )
                                                      case c_genMN
                                                      solve( !KU( senc(kdf(~cak.4,
                                                                           <$Keyserver.1, ~kn.1, ~KS_nonce0.1
                                                                           >),
                                                                       kdf(~cak.4, 'KEK'))
                                                             ) @ #vk.49 )
                                                        case Initial_KeyServer_Send
                                                        SOLVED // trace found
                                                      qed
                                                    qed
                                                  qed
                                                qed
