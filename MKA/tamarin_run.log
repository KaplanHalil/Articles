              qed
            qed
          qed
        next
          case c_kdf
          solve( !KU( ~cak.1 ) @ #vk.17 )
            case Reveal_CAK
            by contradiction /* from formulas */
          qed
        qed
      next
        case split_case_2
        solve( !KU( kdf(~cak.1, <$Keyserver, ~kn, ~KS_nonce0>) ) @ #vk.9 )
          case Initial_KeyServer_Send
          solve( !KU( mac(<$Keyserver.1, count(genMN($Keyserver.1)), ~kn, 
                           senc(z, kdf(~cak, 'KEK'))>,
                          kdf(~cak, 'ICK'))
                 ) @ #vk.15 )
            case Initial_KeyServer_Send
            solve( !KU( kdf(~cak, 'KEK') ) @ #vk.16 )
              case c_kdf
              solve( !KU( ~cak ) @ #vk.17 )
                case Reveal_CAK
                by contradiction /* from formulas */
              qed
            qed
          next
            case c_mac
            solve( !KU( senc(z, kdf(~cak, 'KEK')) ) @ #vk.18 )
              case Initial_KeyServer_Send
              solve( !KU( kdf(~cak.1, 'KEK') ) @ #vk.19 )
                case c_kdf
                solve( !KU( ~cak.1 ) @ #vk.21 )
                  case Reveal_CAK
                  by contradiction /* from formulas */
                qed
              qed
            next
              case Malicious_KeyServer_Send
              solve( !KU( kdf(~cak.1, 'KEK') ) @ #vk.19 )
                case c_kdf
                solve( !KU( ~cak.1 ) @ #vk.21 )
                  case Reveal_CAK
